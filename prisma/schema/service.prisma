model Service {
  id          String @id @default(uuid())
  name        String
  description String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model Category {
  id   String @id @default(uuid())
  name String

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}
