model TechnicianProfile {
  id              String   @id @default(uuid())
  profilePhoto    String?
  bio             String?
  experienceYears Float    @default(0)
  hourlyRate      Int
  serviceAreas    String[] @default([])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  reviews    Review[]
  availability Availability?
  bookings   Booking[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  technicianServices TechnicianService[]

  @@map("technicianProfiles")
}

model Availability {
  id          String      @id @default(uuid())
  weekendDays WeekendDays @default(FRI)
  startTime   String
  endTime     String

  technicianId String            @unique
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("availability")
}
