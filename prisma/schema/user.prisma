model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  phone    String @unique
  password String

  technician TechnicianProfile?
  bookings   Booking[]
  reviews    Review[]
  addresses  Address[]

  role   Role       @default(CUSTOMER)
  status UserStatus @default(UNBAN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
